{
  "name": "@ai-ecoverse/slicc-bios",
  "version": "0.0.0",
  "description": "Slim loader that boots SLICC into OPFS and serves the UI from there",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-bios.git"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "release.yml",
    "repo": "ai-ecoverse/slicc-bios",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "src/packages/package.json",
    "src/packages/package-lock.json",
    "src/packages/pnpm-lock.yaml",
    "src/packages/certs.json",
    "src/packages/agent/package.json",
    "src/packages/agent/pnpm-lock.yaml",
    "src/packages/optional/package.json",
    "src/packages/optional/package-lock.json",
    "src/packages/optional/catalog.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node test/integration/chrome.mjs",
    "pretest": "playwright-core install --no-shell chromium",
    "test": "node --test --test-concurrency=1 --test-timeout=900000 --test-global-setup=node_modules/@ai-ecoverse/slicc-shared-web/harness/global.mjs ${SLICC_TESTS:-test/integration/*.test.mjs}",
    "test:cert": "node --test --test-concurrency=1 --test-timeout=${CERT_BUDGET:-8400000} --test-global-setup=node_modules/@ai-ecoverse/slicc-shared-web/harness/global.mjs test/integration/cert.test.mjs",
    "test:unit": "mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "lint": "slicc-lint",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@ai-ecoverse/slicc": "1.42.4",
    "@ai-ecoverse/slicc-browsers": "1.7.6",
    "@ai-ecoverse/slicc-node": "2.5.1",
    "@ai-ecoverse/slicc-shared-web": "1.23.2",
    "@ai-ecoverse/slicc-spectrum": "1.84.2",
    "@ai-ecoverse/slicc-vault": "1.9.2",
    "@biomejs/biome": "2.5.15",
    "es-module-lexer": "3.0.3",
    "fake-indexeddb": "6.2.5",
    "lefthook": "2.2.1",
    "modern-tar": "0.8.5",
    "monocart-coverage-reports": "2.13.2",
    "playwright-core": "1.64.0",
    "semantic-release": "25.0.9",
    "wrangler": "4.149.0",
    "ws": "8.22.0"
  }
}
