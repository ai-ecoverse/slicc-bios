{
  "name": "slicc-bios",
  "version": "0.0.0",
  "private": true,
  "description": "Slim loader that boots SLICC into OPFS and serves the UI from there",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-bios.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "start": "node test/integration/server.mjs",
    "pretest": "playwright-core install --no-shell chromium",
    "test": "node --test --test-global-setup=test/integration/global.mjs test/integration/*.test.mjs",
    "test:unit": "mcr --name slicc-bios-unit --reports lcovonly,console-details --outputDir coverage/unit --all src --filter '{\"**/src/**/*.js\":true,\"**\":false}' node --test 'test/unit/**/*.test.mjs'",
    "lint": "biome check . && slicc-lint-comments && slicc-no-unit-tests",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "github:ai-ecoverse/slicc-shared-web#0a15806bfd20676bd28a01c4c02bd481cab82751",
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.1.16",
    "modern-tar": "0.8.5",
    "monocart-coverage-reports": "2.13.0",
    "playwright-core": "1.63.0"
  }
}
