{
  "name": "@ai-ecoverse/slicc-bios",
  "version": "0.0.0",
  "description": "Slim loader that boots SLICC into OPFS and serves the UI from there",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-bios.git"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-bios",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "src/packages/package.json",
    "src/packages/package-lock.json",
    "src/packages/pnpm-lock.yaml",
    "src/packages/certs.json",
    "src/packages/tools.json",
    "src/packages/agent/package.json",
    "src/packages/agent/pnpm-lock.yaml",
    "src/packages/optional/catalog.json",
    "src/packages/optional/sources.json",
    "src/packages/optional/exceptions.json"
  ],
  "engines": {
    "node": ">=26"
  },
  "slicc": {
    "unitSources": [
      "src",
      "edge"
    ]
  },
  "scripts": {
    "prepare": "slicc-install-hooks",
    "start": "node test/integration/chrome.mjs",
    "pretest": "slicc-cdp install-browser",
    "test": "node --test --test-concurrency=1 --test-timeout=900000 --test-global-setup=test/integration/global.mjs 'test/integration/*.test.mjs'",
    "test:unit": "mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "lint": "slicc-lint",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@ai-ecoverse/slicc": "1.49.37",
    "@ai-ecoverse/slicc-browsers": "1.18.21",
    "@ai-ecoverse/slicc-cdp": "1.43.1",
    "@ai-ecoverse/slicc-shared-web": "2.13.7",
    "@ai-ecoverse/slicc-spectrum": "1.108.1",
    "@ai-ecoverse/slicc-vault": "1.18.2",
    "@biomejs/biome": "2.6.2",
    "aws4fetch": "1.0.20",
    "es-module-lexer": "3.0.4",
    "fake-indexeddb": "6.2.6",
    "lefthook": "2.2.2",
    "modern-tar": "0.8.6",
    "monocart-coverage-reports": "2.13.2",
    "semantic-release": "25.0.9",
    "ws": "8.22.0"
  }
}
