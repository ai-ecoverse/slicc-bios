#!/bin/sh
set -eu
tree=head
case "${1:-}" in
  head | base) tree=$1; shift ;;
esac
if [ "$#" -eq 0 ]; then
  printf 'usage: sandbox [head|base] <command>\n' >&2
  exit 64
fi
user=cert
if [ "$tree" = base ]; then
  user=certbase
  sudo -n pkill -KILL -u cert 2>/dev/null || true
  sudo -n find /tmp /dev/shm -xdev -user cert -delete 2>/dev/null || true
fi
home=/home/$user
exec sudo -n -u "$user" -H env -i \
  HOME="$home" \
  TMPDIR="$home/tmp" \
  PATH="${CERT_PATH:?}" \
  LANG=C.UTF-8 \
  CI=1 \
  LEFTHOOK=0 \
  SLICC_CLI="${SLICC_CLI:-}" \
  SLICC_NO_UPDATE_CHECK=1 \
  sh -c 'mkdir -p "$TMPDIR" && cd "$HOME/$1" && shift && exec bash -o pipefail -c "$*"' sandbox "$tree" "$@"
