{
  "follow-chat": {
    "match": "/(follow[^/]*|chat)\\.test\\.mjs$"
  },
  "remote-pydata": {
    "match": "/(remote|pydata|updates)\\.test\\.mjs$"
  },
  "users-agent-ui": {
    "match": "/(users|agent-ui)\\.test\\.mjs$"
  },
  "packages-update-cdp": {
    "match": "/(packages|update|cdp)\\.test\\.mjs$"
  },
  "guard": {
    "match": "/(guard-vectors|serve)\\.test\\.mjs$"
  },
  "guard-set-extension-prompt": {
    "match": "/guard-set-extension\\.test\\.mjs$",
    "env": { "GUARD_VARIANTS": "prompt" }
  },
  "guard-set-extension-lagging": {
    "match": "/guard-set-extension\\.test\\.mjs$",
    "env": { "GUARD_VARIANTS": "lagging" }
  },
  "guard-set-proxy-prompt": {
    "match": "/guard-set-proxy\\.test\\.mjs$",
    "env": { "GUARD_VARIANTS": "prompt" }
  },
  "guard-set-proxy-lagging": {
    "match": "/guard-set-proxy\\.test\\.mjs$",
    "env": { "GUARD_VARIANTS": "lagging" }
  },
  "k4-link": {
    "match": "/(k4[^/]*|link)\\.test\\.mjs$"
  },
  "user-packages-keys-favicon": {
    "match": "/(user-packages|keys|favicon)\\.test\\.mjs$"
  },
  "rest": {
    "exclude": "/(follow[^/]*|chat|remote|pydata|updates|users|agent-ui|packages|update|cdp|guard-vectors|guard-set-[a-z]+|serve|k4[^/]*|link|user-packages|keys|favicon)\\.test\\.mjs$"
  },
  "sweep": {
    "match": "/(sweep|pins)\\.test\\.mjs$"
  }
}
